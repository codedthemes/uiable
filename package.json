{
  "name": "UIAble",
  "version": "1.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "registry:generate": "node src/scripts/generate-registry.mjs",
    "registry:split": "node src/scripts/split-registry-by-tier.mjs",
    "registry:build": "npm run registry:generate && npm run registry:split && shadcn build .registry-build/public/registry.json --output .registry-build/public-temp && node src/scripts/sync-dir.mjs .registry-build/public-temp public/r && npm run registry:catalog",
    "registry:catalog": "node src/scripts/build-catalog.mjs",
    "registry:build:pro": "npm run registry:split && shadcn build .registry-build/pro/registry.json --output .pro-registry/r-flat && node src/scripts/split-pro-registry.mjs",
    "build": "npm run registry:build && npm run registry:build:pro && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.19",
    "@base-ui/react": "1.6.0",
    "@daypicker/persian": "10.0.1",
    "@shadcn/react": "0.3.0",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-table": "8.21.3",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.18",
    "chrono-node": "2.9.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.42.2",
    "iconsax-reactjs": "0.0.8",
    "input-otp": "1.4.2",
    "lenis": "1.3.25",
    "lucide-react": "1.23.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "ogl": "1.0.11",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-resizable-panels": "4.12.1",
    "react-textarea-autosize": "8.5.9",
    "react-qr-code": "2.2.0",
    "recharts": "3.9.2",
    "shadcn": "4.17.0",
    "sonner": "2.0.7",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react-swc": "4.3.2",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-perfectionist": "^5.10.1",
    "husky": "9.1.7",
    "jest-axe": "11.0.0",
    "jsdom": "29.1.1",
    "lint-staged": "15.2.11",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "shiki": "4.3.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animated": "2.1.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "yaml": "2.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,mdx}": [
      "prettier --write"
    ],
    "public/r/**/*.json": [
      "prettier --write"
    ]
  }
}
