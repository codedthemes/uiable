      "content": "// shadcn\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupAction,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarTrigger,\n} from \"@/components/ui/sidebar\"\n\n// third-party\nimport { toast } from \"sonner\"\n\n// assets\nimport { FrameIcon, MapIcon, PieChartIcon, PlusIcon } from \"lucide-react\"\n\n//  ------------------------------ | SIDEBAR - GROUP ACTION | ------------------------------  //\n\nexport default function AppSidebar() {\n  return (\n    <SidebarProvider className=\"relative min-h-[450px]\">\n      <Sidebar className=\"absolute h-[450px]\">\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel className=\"py-3\">Projects</SidebarGroupLabel>\n            <SidebarGroupAction\n              title=\"Add Project\"\n              onClick={() => toast(\"You clicked the group action!\")}\n            >\n              <PlusIcon /> <span className=\"sr-only\">Add Project</span>\n            </SidebarGroupAction>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem>\n                  <SidebarMenuButton render={<a href=\"#\" />}>\n                    <FrameIcon />\n                    <span>Design Engineering</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n                <SidebarMenuItem>\n                  <SidebarMenuButton render={<a href=\"#\" />}>\n                    <PieChartIcon />\n                    <span>Sales & Marketing</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n                <SidebarMenuItem>\n                  <SidebarMenuButton render={<a href=\"#\" />}>\n                    <MapIcon />\n                    <span>Travel</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n      </Sidebar>\n      <main className=\"flex-1 overflow-auto bg-muted/20\">\n        <header className=\"flex h-14 items-center border-b border-border/50 bg-background/50 px-4 backdrop-blur\">\n          <SidebarTrigger className=\"-ml-1\" />\n        </header>\n      </main>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/sidebar/sidebar-group-action.tsx"
    }
  ],
