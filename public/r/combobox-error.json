{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "combobox-error",
  "title": "Combobox Error",
  "description": "Combobox Error variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/combobox"],
  "files": [
    {
      "path": "src/components/uiable/combobox/combobox-error.tsx",
      "content": "// shadcn\nimport {\n  Combobox,\n  ComboboxContent,\n  ComboboxEmpty,\n  ComboboxInput,\n  ComboboxItem,\n  ComboboxList,\n} from \"@/components/ui/combobox\"\n\n// assets\nimport { SearchX } from \"lucide-react\"\n\n// constants\nconst frameworks = [\n  \"Next.js\",\n  \"SvelteKit\",\n  \"Nuxt.js\",\n  \"Remix\",\n  \"Astro\",\n] as const\n\n//  ------------------------------ | COMBOBOX - ERROR | ------------------------------  //\n\nexport function ComboboxError() {\n  return (\n    <Combobox items={frameworks}>\n      <ComboboxInput placeholder=\"Select a framework\" />\n      <ComboboxContent>\n        <ComboboxEmpty className=\"flex-col items-center justify-center gap-3 p-6 text-center\">\n          <div className=\"flex size-10 items-center justify-center rounded-lg bg-destructive/10 text-destructive dark:bg-destructive/20\">\n            <SearchX className=\"size-5\" />\n          </div>\n          <div className=\"space-y-1\">\n            <p className=\"text-sm font-semibold text-foreground\">\n              No results found\n            </p>\n            <p className=\"max-w-[200px] text-xs text-muted-foreground\">\n              We couldn't find anything matching your search query.\n            </p>\n          </div>\n        </ComboboxEmpty>\n        <ComboboxList>\n          {(item) => (\n            <ComboboxItem key={item} value={item}>\n              {item}\n            </ComboboxItem>\n          )}\n        </ComboboxList>\n      </ComboboxContent>\n    </Combobox>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/combobox/combobox-error.tsx"
    }
  ],
  "categories": ["combobox"],
  "type": "registry:ui"
}
