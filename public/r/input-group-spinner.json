{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-group-spinner",
  "title": "Input Group Spinner",
  "description": "Input Group Spinner variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/input-group", "@uiable/spinner"],
  "files": [
    {
      "path": "src/components/uiable/input-group/input-group-spinner.tsx",
      "content": "// shadcn\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n  InputGroupText,\n} from \"@/components/ui/input-group\"\nimport { Spinner } from \"@/components/ui/spinner\"\n\n// assets\nimport { LoaderIcon } from \"lucide-react\"\n\n//  ------------------------------ | INPUT GROUP - SPINNER | ------------------------------  //\n\nexport default function InputGroupSpinner() {\n  return (\n    <div className=\"grid w-full max-w-sm gap-4\">\n      <InputGroup>\n        <InputGroupInput placeholder=\"Searching...\" />\n        <InputGroupAddon align=\"inline-end\">\n          <Spinner />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Processing...\" />\n        <InputGroupAddon>\n          <Spinner />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Saving changes...\" />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupText>Saving...</InputGroupText>\n          <Spinner />\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Refreshing data...\" />\n        <InputGroupAddon>\n          <LoaderIcon className=\"animate-spin\" />\n        </InputGroupAddon>\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupText className=\"text-muted-foreground\">\n            Please wait...\n          </InputGroupText>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/input-group/input-group-spinner.tsx"
    }
  ],
  "categories": ["input-group"],
  "type": "registry:ui"
}
