      "path": "src/components/uiable/message/message-with-avatar.tsx",
      "content": "// shadcn\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Bubble, BubbleContent, BubbleGroup } from \"@/components/ui/bubble\"\nimport { Message, MessageAvatar, MessageContent } from \"@/components/ui/message\"\n\n//  ------------------------------ | MESSAGE - WITH AVATAR | ------------------------------  //\n\nexport function MessageAvatars() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-6\">\n      <Message>\n        <MessageAvatar>\n          <Avatar>\n            <AvatarImage\n              src=\"https://cdn.uiable.com/user/avatar-1.jpg\"\n              alt=\"@avatar\"\n            />\n            <AvatarFallback>R</AvatarFallback>\n          </Avatar>\n        </MessageAvatar>\n        <MessageContent>\n          <Bubble variant=\"muted\">\n            <BubbleContent>\n              The build failed during dependency installation.\n            </BubbleContent>\n          </Bubble>\n        </MessageContent>\n      </Message>\n      <Message align=\"end\">\n        <MessageAvatar>\n          <Avatar>\n            <AvatarImage\n              src=\"https://cdn.uiable.com/user/avatar-2.jpg\"\n              alt=\"@avatar\"\n            />\n            <AvatarFallback>R</AvatarFallback>\n          </Avatar>\n        </MessageAvatar>\n        <MessageContent>\n          <Bubble>\n            <BubbleContent className=\"dark:text-white\">\n              Can you share the exact error?\n            </BubbleContent>\n          </Bubble>\n        </MessageContent>\n      </Message>\n      <Message>\n        <MessageAvatar>\n          <Avatar>\n            <AvatarImage\n              src=\"https://cdn.uiable.com/user/avatar-3.jpg\"\n              alt=\"@avatar\"\n            />\n            <AvatarFallback>R</AvatarFallback>\n          </Avatar>\n        </MessageAvatar>\n        <MessageContent>\n          <BubbleGroup>\n            <Bubble variant=\"muted\">\n              <BubbleContent>Here&apos;s the error from the logs</BubbleContent>\n            </Bubble>\n            <Bubble variant=\"muted\">\n              <BubbleContent>\n                Something went wrong with the build. The libraries are not\n                installed correctly. Try running the build again.\n              </BubbleContent>\n            </Bubble>\n          </BubbleGroup>\n        </MessageContent>\n      </Message>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/message/message-with-avatar.tsx"
    }
  ],
  "categories": ["message"],
  "type": "registry:ui"
}
