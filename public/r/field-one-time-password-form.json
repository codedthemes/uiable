{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-one-time-password-form",
  "title": "Field One Time Password Form",
  "description": "Field One Time Password Form variant for component.",
  "registryDependencies": ["@uiable/button", "@uiable/field", "@uiable/input-otp"],
  "files": [
    {
      "path": "src/components/uiable/field/field-one-time-password-form.tsx",
      "content": "// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLegend,\n  FieldSet,\n} from \"@/components/ui/field\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\n\n//  ------------------------------ | FIELD - ONE TIME PASSWORD FORM | ------------------------------  //\n\nexport function FieldOneTimePasswordForm() {\n  return (\n    <form className=\"w-full max-w-sm\" onSubmit={(e) => e.preventDefault()}>\n      <FieldSet>\n        <FieldLegend className=\"flex w-full items-center justify-between\">\n          <h5>Verification Code</h5>\n          <span className=\"text-xs font-medium text-muted-foreground\">\n            Expires in 5:00\n          </span>\n        </FieldLegend>\n        <FieldDescription>\n          Enter the 6-digit verification code sent to your authentication app or\n          phone.\n        </FieldDescription>\n        <FieldGroup>\n          <Field>\n            <InputOTP maxLength={6} id=\"otp-verification\" required>\n              <InputOTPGroup>\n                <InputOTPSlot index={0} />\n                <InputOTPSlot index={1} />\n                <InputOTPSlot index={2} />\n              </InputOTPGroup>\n              <InputOTPSeparator />\n              <InputOTPGroup>\n                <InputOTPSlot index={3} />\n                <InputOTPSlot index={4} />\n                <InputOTPSlot index={5} />\n              </InputOTPGroup>\n            </InputOTP>\n            <FieldDescription>\n              Please do not share your verification code with anyone.\n            </FieldDescription>\n          </Field>\n          <Field>\n            <Button type=\"submit\" className=\"w-full\">\n              Verify security code\n            </Button>\n            <div className=\"text-center text-xs text-muted-foreground\">\n              Didn&apos;t get the code?{\" \"}\n              <a\n                href=\"#\"\n                className=\"font-medium text-foreground underline underline-offset-4 transition-colors hover:text-primary\"\n              >\n                Resend code\n              </a>\n            </div>\n          </Field>\n        </FieldGroup>\n      </FieldSet>\n    </form>\n  )\n}\n\nexport default FieldOneTimePasswordForm\n",
      "type": "registry:component",
      "target": "@components/uiable/field/field-one-time-password-form.tsx"
    }
  ],
  "categories": ["field"],
  "type": "registry:ui"
}
