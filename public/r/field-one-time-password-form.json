      "path": "src/components/uiable/field/field-one-time-password-form.tsx",
      "content": "// shadcn\r\nimport { Button } from \"@/components/ui/button\"\r\nimport {\r\n  Field,\r\n  FieldDescription,\r\n  FieldGroup,\r\n  FieldLegend,\r\n  FieldSet,\r\n} from \"@/components/ui/field\"\r\nimport {\r\n  InputOTP,\r\n  InputOTPGroup,\r\n  InputOTPSeparator,\r\n  InputOTPSlot,\r\n} from \"@/components/ui/input-otp\"\r\n\r\n//  ------------------------------ | FIELD - ONE TIME PASSWORD FORM | ------------------------------  //\r\n\r\nexport function FieldOneTimePasswordForm() {\r\n  return (\r\n    <form className=\"w-full max-w-sm\" onSubmit={(e) => e.preventDefault()}>\r\n      <FieldSet>\r\n        <FieldLegend className=\"flex w-full items-center justify-between\">\r\n          <h5>Verification Code</h5>\r\n          <span className=\"text-xs font-medium text-muted-foreground\">\r\n            Expires in 5:00\r\n          </span>\r\n        </FieldLegend>\r\n        <FieldDescription>\r\n          Enter the 6-digit verification code sent to your authentication app or\r\n          phone.\r\n        </FieldDescription>\r\n        <FieldGroup>\r\n          <Field>\r\n            <InputOTP maxLength={6} id=\"otp-verification\" required>\r\n              <InputOTPGroup>\r\n                <InputOTPSlot index={0} />\r\n                <InputOTPSlot index={1} />\r\n                <InputOTPSlot index={2} />\r\n              </InputOTPGroup>\r\n              <InputOTPSeparator />\r\n              <InputOTPGroup>\r\n                <InputOTPSlot index={3} />\r\n                <InputOTPSlot index={4} />\r\n                <InputOTPSlot index={5} />\r\n              </InputOTPGroup>\r\n            </InputOTP>\r\n            <FieldDescription>\r\n              Please do not share your verification code with anyone.\r\n            </FieldDescription>\r\n          </Field>\r\n          <Field>\r\n            <Button type=\"submit\" className=\"w-full\">\r\n              Verify security code\r\n            </Button>\r\n            <div className=\"text-center text-xs text-muted-foreground\">\r\n              Didn&apos;t get the code?{\" \"}\r\n              <a\r\n                href=\"#\"\r\n                className=\"font-medium text-foreground underline underline-offset-4 transition-colors hover:text-primary\"\r\n              >\r\n                Resend code\r\n              </a>\r\n            </div>\r\n          </Field>\r\n        </FieldGroup>\r\n      </FieldSet>\r\n    </form>\r\n  )\r\n}\r\n\r\nexport default FieldOneTimePasswordForm\r\n",
      "type": "registry:component",
      "target": "@components/uiable/field/field-one-time-password-form.tsx"
    }
  ],
