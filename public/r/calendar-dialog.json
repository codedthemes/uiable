{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "calendar-dialog",
  "title": "Calendar Dialog",
  "description": "Calendar Dialog variant for component.",
  "dependencies": ["date-fns", "lucide-react"],
  "registryDependencies": ["@uiable/button", "@uiable/calendar", "@uiable/card", "@uiable/dialog"],
  "files": [
    {
      "path": "src/components/uiable/calendar/calendar-dialog.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport { Calendar } from \"@/components/ui/calendar\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\nimport {\n  Dialog,\n  DialogContent,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@/components/ui/dialog\"\n\n// third-party\nimport { format } from \"date-fns\"\n\n// assets\nimport { CalendarIcon } from \"lucide-react\"\n\n//  ------------------------------ | CALENDAR - DIALOG | ------------------------------  //\n\nexport function CalendarDialog() {\n  const [open, setOpen] = useState(false)\n  const [selectedDate, setSelectedDate] = useState<Date | undefined>(\n    new Date(new Date().getFullYear(), new Date().getMonth(), 15)\n  )\n  const [currentMonth, setCurrentMonth] = useState<Date>(\n    new Date(new Date().getFullYear(), new Date().getMonth(), 1)\n  )\n\n  return (\n    <Card className=\"mx-auto w-full max-w-[380px]\">\n      <CardHeader className=\"pt-3 pb-3\">\n        <CardTitle className=\"text-base font-semibold\">\n          Schedule Consultation\n        </CardTitle>\n        <CardDescription className=\"text-xs\">\n          Select a preferred date for your upcoming session\n        </CardDescription>\n      </CardHeader>\n      <CardContent className=\"flex flex-col gap-4\">\n        <Dialog open={open} onOpenChange={setOpen}>\n          <DialogTrigger\n            render={\n              <Button\n                variant=\"outline\"\n                className=\"w-full justify-start text-left font-normal\"\n              />\n            }\n          >\n            <CalendarIcon className=\"mr-2 size-4 text-muted-foreground\" />\n            {selectedDate ? (\n              <span className=\"font-medium text-foreground\">\n                {format(selectedDate, \"EEE, MMM dd, yyyy\")}\n              </span>\n            ) : (\n              <span className=\"text-muted-foreground\">\n                Pick an appointment date\n              </span>\n            )}\n          </DialogTrigger>\n\n          <DialogContent className=\"max-w-[360px] overflow-hidden p-0 sm:max-w-[400px]\">\n            <DialogHeader className=\"justify-center border-b px-5 py-4\">\n              <DialogTitle className=\"text-base font-semibold\">\n                Select Appointment Date\n              </DialogTitle>\n            </DialogHeader>\n\n            <div className=\"flex justify-center p-3\">\n              <Calendar\n                mode=\"single\"\n                selected={selectedDate}\n                onSelect={setSelectedDate}\n                month={currentMonth}\n                onMonthChange={setCurrentMonth}\n                className=\"p-0 [--cell-size:--spacing(9.5)]\"\n              />\n            </div>\n\n            <DialogFooter className=\"m-0 mx-0 mb-0 flex flex-row items-center justify-between border-t bg-muted/20 px-5 py-3.5 sm:flex-row sm:justify-between\">\n              <Button\n                variant=\"ghost\"\n                onClick={() => setSelectedDate(undefined)}\n                className=\"text-xs text-muted-foreground\"\n              >\n                Clear\n              </Button>\n              <Button disabled={!selectedDate} onClick={() => setOpen(false)}>\n                Confirm Date\n              </Button>\n            </DialogFooter>\n          </DialogContent>\n        </Dialog>\n\n        {selectedDate && (\n          <div className=\"rounded-md border border-dashed p-3 text-xs text-muted-foreground\">\n            <span className=\"font-medium text-foreground\">Next step: </span>\n            Your consultation is reserved for{\" \"}\n            <span className=\"font-medium text-primary\">\n              {format(selectedDate, \"EEEE, MMMM d\")}\n            </span>\n            .\n          </div>\n        )}\n      </CardContent>\n    </Card>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/calendar/calendar-dialog.tsx"
    }
  ],
  "categories": ["calendar"],
  "type": "registry:ui"
}
