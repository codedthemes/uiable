{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-2",
  "title": "Sidebar 2",
  "description": "Sidebar 2 variant for component.",
  "dependencies": ["iconsax-reactjs", "lucide-react"],
  "registryDependencies": ["@uiable/avatar", "@uiable/button", "@uiable/card", "@uiable/collapsible", "@uiable/logo", "@uiable/sidebar"],
  "files": [
    {
      "path": "src/components/uiable/sidebar/sidebar-2.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\n// shadcn\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Button } from \"@/components/ui/button\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport {\n  Collapsible,\n  CollapsibleContent,\n  CollapsibleTrigger,\n} from \"@/components/ui/collapsible\"\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSub,\n  SidebarMenuSubButton,\n  SidebarMenuSubItem,\n  SidebarProvider,\n  SidebarRail,\n} from \"@/components/ui/sidebar\"\n\n// third-party\nimport {\n  ArrowRight2,\n  Clipboard,\n  Designtools,\n  DocumentText,\n  Level,\n  Logout,\n  NotificationStatus,\n  PasswordCheck,\n  Shield,\n  Sort,\n  StatusUp,\n} from \"iconsax-reactjs\"\n\n// project-imports\n// project\nimport Logo from \"@/components/uiable/layout/shared/logo\"\n\n// assets\nimport { LockKeyhole, Power, Settings, User } from \"lucide-react\"\n\nconst imgCoupon = {\n  src: \"https://cdn.uiable.com/application/img-coupon.png\",\n}\nconst uImg1 = {\n  src: \"https://cdn.uiable.com/user/avatar-1.jpg\",\n}\n\n// ── Dummy data ────────────────────────────────────────────────────────────── //\n\n//  ------------------------------ | COMPONENT - SIDEBAR 2 | ------------------------------  //\n\nexport default function Sidebar2() {\n  const [isUserOpen, setIsUserOpen] = useState(false)\n  const [activeItem, setActiveItem] = useState(\"dashboard\")\n\n  return (\n    <SidebarProvider className=\"relative h-[600px] w-full overflow-hidden rounded-lg border bg-background\">\n      <Sidebar\n        collapsible=\"icon\"\n        variant=\"inset\"\n        className=\"absolute z-10 h-full border-r border-dashed border-border\"\n      >\n        <SidebarHeader className=\"px-4 pt-4 pb-2\">\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <Logo />\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarHeader>\n\n        <SidebarContent className=\"gap-0 px-2 *:py-0\">\n          {/* User Profile Card */}\n          <Card className=\"m-1.75 bg-[#f3f5f7] shadow-none dark:bg-[#1b232d]\">\n            <CardContent className=\"p-5!\">\n              <Collapsible\n                open={isUserOpen}\n                onOpenChange={setIsUserOpen}\n                className=\"flex flex-col gap-2\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <Avatar className=\"h-10 w-10 border-2 border-background\">\n                    <AvatarImage src={uImg1.src} alt=\"User\" />\n                    <AvatarFallback className=\"bg-primary/10 font-bold text-primary\">\n                      JS\n                    </AvatarFallback>\n                  </Avatar>\n                  <div className=\"flex flex-1 flex-col\">\n                    <h6 className=\"mb-0\">John Smith</h6>\n                    <small className=\"text-muted-foreground\">\n                      Administrator\n                    </small>\n                  </div>\n                  <CollapsibleTrigger\n                    render={\n                      <Button variant=\"ghost\" size=\"icon\">\n                        <Sort className=\"size-5.5\" />\n                      </Button>\n                    }\n                  />\n                </div>\n                <CollapsibleContent>\n                  <div className=\"pt-3 *:flex *:items-center *:gap-2.5 *:py-2 *:last:pb-0 *:hover:text-primary\">\n                    <a href=\"#!\">\n                      <User className=\"size-4\" />\n                      <span>My Account</span>\n                    </a>\n                    <a href=\"#!\">\n                      <Settings className=\"size-4\" />\n                      <span>Settings</span>\n                    </a>\n                    <a href=\"#!\">\n                      <LockKeyhole className=\"size-4\" />\n                      <span>Lock Screen</span>\n                    </a>\n                    <a href=\"#!\">\n                      <Power className=\"size-4\" />\n                      <span>Logout</span>\n                    </a>\n                  </div>\n                </CollapsibleContent>\n              </Collapsible>\n            </CardContent>\n          </Card>\n\n          {/* Dashboard */}\n          <SidebarGroup>\n            <SidebarGroupLabel className=\"px-5.5 pt-6 pb-2 text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase\">\n              Dashboard\n            </SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"dashboard\"}\n                    onClick={() => setActiveItem(\"dashboard\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <StatusUp className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Default</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n\n          {/* Authentication */}\n          <SidebarGroup>\n            <SidebarGroupLabel className=\"px-5.5 pt-6 pb-2 text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase\">\n              Authentication\n            </SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"login\"}\n                    onClick={() => setActiveItem(\"login\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <Shield className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Login</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"register\"}\n                    onClick={() => setActiveItem(\"register\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <PasswordCheck className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Register</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n\n          {/* Components */}\n          <SidebarGroup>\n            <SidebarGroupLabel className=\"px-5.5 pt-6 pb-2 text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase\">\n              Components\n            </SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"components\"}\n                    onClick={() => setActiveItem(\"components\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <Clipboard className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Components</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"blocks\"}\n                    onClick={() => setActiveItem(\"blocks\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <Designtools className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Blocks</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n\n          {/* Extra */}\n          <SidebarGroup>\n            <SidebarGroupLabel className=\"px-5.5 pt-6 pb-2 text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase\">\n              Extra\n            </SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"docs\"}\n                    onClick={() => setActiveItem(\"docs\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <DocumentText className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Documentation</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n              <SidebarMenu>\n                <Collapsible className=\"group/collapsible\">\n                  <SidebarMenuItem>\n                    <CollapsibleTrigger\n                      render={\n                        <SidebarMenuButton\n                          tooltip=\"Menu levels\"\n                          className=\"rounded-lg px-5 py-3.5\"\n                        />\n                      }\n                    >\n                      <Level className=\"size-5.5!\" variant=\"Bulk\" />\n                      <span className=\"font-medium\">Menu levels</span>\n                      <ArrowRight2 className=\"ml-auto size-4 transition-transform group-data-[state=open]/collapsible:rotate-90\" />\n                    </CollapsibleTrigger>\n                    <CollapsibleContent>\n                      <SidebarMenuSub>\n                        <SidebarMenuSubItem>\n                          <SidebarMenuSubButton>\n                            <span>Level 2.1</span>\n                          </SidebarMenuSubButton>\n                        </SidebarMenuSubItem>\n                        <Collapsible className=\"group/collapsible-2\">\n                          <SidebarMenuSubItem>\n                            <CollapsibleTrigger\n                              nativeButton={false}\n                              render={\n                                <SidebarMenuSubButton className=\"flex w-full justify-between\" />\n                              }\n                            >\n                              <span>Level 2.2</span>\n                              <ArrowRight2 className=\"ml-auto size-4 transition-transform group-data-[state=open]/collapsible-2:rotate-90\" />\n                            </CollapsibleTrigger>\n                            <CollapsibleContent>\n                              <SidebarMenuSub className=\"mt-1 ml-2 border-l border-border/50 pl-2\">\n                                <SidebarMenuSubItem>\n                                  <SidebarMenuSubButton>\n                                    <span>Level 3.1</span>\n                                  </SidebarMenuSubButton>\n                                </SidebarMenuSubItem>\n                                <Collapsible className=\"group/collapsible-3\">\n                                  <SidebarMenuSubItem>\n                                    <CollapsibleTrigger\n                                      nativeButton={false}\n                                      render={\n                                        <SidebarMenuSubButton className=\"flex w-full justify-between\" />\n                                      }\n                                    >\n                                      <span>Level 3.2</span>\n                                      <ArrowRight2 className=\"ml-auto size-4 transition-transform group-data-[state=open]/collapsible-3:rotate-90\" />\n                                    </CollapsibleTrigger>\n                                    <CollapsibleContent>\n                                      <SidebarMenuSub className=\"mt-1 ml-2 border-l border-border/50 pl-2\">\n                                        <SidebarMenuSubItem>\n                                          <SidebarMenuSubButton>\n                                            <span>Level 4.1</span>\n                                          </SidebarMenuSubButton>\n                                        </SidebarMenuSubItem>\n                                        <SidebarMenuSubItem>\n                                          <SidebarMenuSubButton>\n                                            <span>Level 4.2</span>\n                                          </SidebarMenuSubButton>\n                                        </SidebarMenuSubItem>\n                                        <SidebarMenuSubItem>\n                                          <SidebarMenuSubButton>\n                                            <span>Level 4.3</span>\n                                          </SidebarMenuSubButton>\n                                        </SidebarMenuSubItem>\n                                      </SidebarMenuSub>\n                                    </CollapsibleContent>\n                                  </SidebarMenuSubItem>\n                                </Collapsible>\n                                <Collapsible className=\"group/collapsible-4\">\n                                  <SidebarMenuSubItem>\n                                    <CollapsibleTrigger\n                                      nativeButton={false}\n                                      render={\n                                        <SidebarMenuSubButton className=\"flex w-full justify-between\" />\n                                      }\n                                    >\n                                      <span>Level 3.3</span>\n                                      <ArrowRight2 className=\"ml-auto size-4 transition-transform group-data-[state=open]/collapsible-4:rotate-90\" />\n                                    </CollapsibleTrigger>\n                                    <CollapsibleContent>\n                                      <SidebarMenuSub className=\"mt-1 ml-2 border-l border-border/50 pl-2\">\n                                        <SidebarMenuSubItem>\n                                          <SidebarMenuSubButton>\n                                            <span>Level 4.1</span>\n                                          </SidebarMenuSubButton>\n                                        </SidebarMenuSubItem>\n                                        <SidebarMenuSubItem>\n                                          <SidebarMenuSubButton>\n                                            <span>Level 4.2</span>\n                                          </SidebarMenuSubButton>\n                                        </SidebarMenuSubItem>\n                                        <SidebarMenuSubItem>\n                                          <SidebarMenuSubButton>\n                                            <span>Level 4.3</span>\n                                          </SidebarMenuSubButton>\n                                        </SidebarMenuSubItem>\n                                      </SidebarMenuSub>\n                                    </CollapsibleContent>\n                                  </SidebarMenuSubItem>\n                                </Collapsible>\n                              </SidebarMenuSub>\n                            </CollapsibleContent>\n                          </SidebarMenuSubItem>\n                        </Collapsible>\n                        <SidebarMenuSubItem>\n                          <SidebarMenuSubButton>\n                            <span>Level 2.3</span>\n                          </SidebarMenuSubButton>\n                        </SidebarMenuSubItem>\n                      </SidebarMenuSub>\n                    </CollapsibleContent>\n                  </SidebarMenuItem>\n                </Collapsible>\n              </SidebarMenu>\n              <SidebarMenu>\n                <SidebarMenuItem>\n                  <SidebarMenuButton\n                    isActive={activeItem === \"sample\"}\n                    onClick={() => setActiveItem(\"sample\")}\n                    className=\"rounded-lg px-5 py-3.5 data-[active=true]:bg-primary/10 data-[active=true]:text-primary\"\n                  >\n                    <NotificationStatus className=\"size-5.5!\" variant=\"Bulk\" />\n                    <span className=\"font-medium\">Sample Page</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n\n          {/* Upgrade Card */}\n          <Card className=\"mx-1.75 my-3.75 shadow-none\">\n            <CardContent className=\"text-center\">\n              <img\n                src={imgCoupon.src}\n                alt=\"coupon\"\n                className=\"mx-auto w-2/4 max-w-full\"\n              />\n              <h5 className=\"mt-1 mb-0\">UIAble</h5>\n              <p className=\"mb-4\">Checkout pro features</p>\n              <Button className=\"gap-2 bg-yellow-500 hover:bg-yellow-600\">\n                <Logout />\n                Upgrade to Pro\n              </Button>\n            </CardContent>\n          </Card>\n        </SidebarContent>\n        <SidebarRail />\n      </Sidebar>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/sidebar/sidebar-2.tsx"
    }
  ],
  "categories": ["sidebar"],
  "type": "registry:ui"
}
