      "path": "src/components/uiable/blocks/reset-password/reset-password-1/reset-password-1.tsx",
      "content": "// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport { Field, FieldGroup, FieldLabel } from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\n\n//  ------------------------------ | RESET PASSWORD 1 | ------------------------------  //\n\nexport default function ResetPassword1() {\n  return (\n    <div className=\"flex min-h-screen w-full items-center justify-center bg-[url('https://cdn.uiable.com/authentication/img-auth-bg.jpg')] bg-cover bg-center px-4 py-10 dark:bg-[url('https://cdn.uiable.com/authentication/img-auth-bg-dark.jpg')]\">\n      <Card className=\"w-full max-w-md shadow-none\">\n        <CardContent className=\"space-y-4 p-6 sm:p-10\">\n          <div className=\"mb-4\">\n            <h3 className=\"mb-2 text-xl font-semibold text-foreground\">\n              Reset Password\n            </h3>\n            <p className=\"text-sm text-muted-foreground\">\n              Please choose your new password\n            </p>\n          </div>\n\n          <FieldGroup className=\"mt-4\">\n            <Field>\n              <FieldLabel htmlFor=\"password\">Password</FieldLabel>\n              <Input\n                id=\"password\"\n                type=\"password\"\n                required\n                placeholder=\"Password\"\n              />\n            </Field>\n\n            <Field>\n              <FieldLabel htmlFor=\"confirmPassword\">\n                Confirm Password\n              </FieldLabel>\n              <Input\n                id=\"confirmPassword\"\n                type=\"password\"\n                required\n                placeholder=\"Confirm Password\"\n              />\n            </Field>\n\n            <Button type=\"button\" className=\"mt-2 w-full hover:scale-[1.02]\">\n              Reset Password\n            </Button>\n          </FieldGroup>\n        </CardContent>\n      </Card>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/blocks/reset-password/reset-password-1/reset-password-1.tsx"
    }
  ],
  "categories": ["reset-password"],
  "type": "registry:block"
}
