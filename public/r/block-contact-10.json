      "path": "src/components/uiable/blocks/contact/contact-10/contact-10.tsx",
      "content": "\"use client\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport { Field, FieldGroup, FieldLabel } from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport { Textarea } from \"@/components/ui/textarea\"\n\n// third-party\nimport { motion, type Variants } from \"framer-motion\"\n\n//  ------------------------------ | CONTACT 10 | ------------------------------  //\n\nconst containerVariants: Variants = {\n  hidden: { opacity: 0 },\n  visible: {\n    opacity: 1,\n    transition: {\n      staggerChildren: 0.12,\n      delayChildren: 0.1,\n    },\n  },\n}\n\nconst itemVariants: Variants = {\n  hidden: { y: 20, opacity: 0 },\n  visible: {\n    y: 0,\n    opacity: 1,\n    transition: { duration: 0.5, ease: [0.16, 1, 0.3, 1] },\n  },\n}\n\nexport default function Contact10() {\n  return (\n    <div className=\"relative overflow-hidden bg-slate-200 py-24 sm:py-32 dark:bg-slate-800\">\n      <div className=\"relative z-30 container mx-auto px-6 lg:px-8\">\n        <div className=\"flex flex-col items-center justify-center gap-6 lg:flex-row\">\n          <div className=\"w-full basis-full lg:basis-5/12\"></div>\n          <div className=\"w-full basis-full text-center lg:basis-4/12\">\n            <motion.div\n              initial=\"hidden\"\n              whileInView=\"visible\"\n              viewport={{ once: true, margin: \"-100px\" }}\n              variants={containerVariants}\n              className=\"mx-auto w-full rounded-xl bg-card p-5 shadow-[0_0_40px_-8px_#4680ff38] sm:p-14\"\n            >\n              <div className=\"flex flex-col gap-8\">\n                <div className=\"mx-auto flex max-w-108 flex-col items-center gap-2 text-center sm:gap-4\">\n                  <motion.h2\n                    variants={itemVariants}\n                    className=\"text-lg font-medium text-slate-800 sm:text-3xl dark:text-slate-100\"\n                  >\n                    Get in Touch\n                  </motion.h2>\n                  <motion.p\n                    variants={itemVariants}\n                    className=\"mmax-w-90 text-slate-600 dark:text-slate-400\"\n                  >\n                    Have a question or idea? Drop me a line — I’d love to hear\n                    from you and will get back to you soon.\n                  </motion.p>\n                </div>\n                <FieldGroup className=\"text-left\">\n                  <motion.div variants={itemVariants}>\n                    <Field>\n                      <FieldLabel htmlFor=\"fieldgroup-name\">\n                        First Name\n                      </FieldLabel>\n                      <Input id=\"fieldgroup-name\" placeholder=\"Jordan\" />\n                    </Field>\n                  </motion.div>\n                  <motion.div variants={itemVariants}>\n                    <Field>\n                      <FieldLabel htmlFor=\"fieldgroup-email\">Email</FieldLabel>\n                      <Input\n                        id=\"fieldgroup-email\"\n                        type=\"email\"\n                        placeholder=\"name@example.com\"\n                      />\n                    </Field>\n                  </motion.div>\n                  <motion.div variants={itemVariants}>\n                    <Field>\n                      <FieldLabel htmlFor=\"textarea-header-footer-12\">\n                        Messege\n                      </FieldLabel>\n                      <Textarea\n                        id=\"textarea-header-footer-12\"\n                        placeholder=\"Enter your text here...\"\n                        className=\"resize-none\"\n                      />\n                    </Field>\n                  </motion.div>\n                  <motion.div variants={itemVariants}>\n                    <Field orientation=\"horizontal\" className=\"justify-center\">\n                      <Button\n                        type=\"reset\"\n                        size=\"lg\"\n                        variant=\"outline\"\n                        className=\"white rounded-full bg-card hover:translate-y-1 hover:opacity-90\"\n                      >\n                        Reset\n                      </Button>\n                      <Button\n                        type=\"submit\"\n                        size=\"lg\"\n                        className=\"rounded-full shadow-[0_4px_6px_-2px_#b6c0dbd9] transition-all hover:translate-y-1 hover:opacity-90 hover:shadow-none dark:shadow-none\"\n                      >\n                        Submit\n                      </Button>\n                    </Field>\n                  </motion.div>\n                </FieldGroup>\n              </div>\n            </motion.div>\n          </div>\n        </div>\n      </div>\n      <div className=\"absolute inset-0 z-20 bg-slate-800/50\"></div>\n      <motion.div\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ duration: 1 }}\n        className=\"absolute inset-0 z-10\"\n      >\n        <iframe\n          src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14875.987145437051!2d72.86633095391547!3d21.231976027219776!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be04f0778f12ea7%3A0xd4bc1f45fa091301!2sSurat%20Digital%20Valley!5e0!3m2!1sen!2sin!4v1779250060915!5m2!1sen!2sin\"\n          width=\"100%\"\n          height=\"100%\"\n          style={{ border: 0 }}\n          allowFullScreen\n          loading=\"lazy\"\n          referrerPolicy=\"no-referrer-when-downgrade\"\n        ></iframe>\n      </motion.div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/blocks/contact/contact-10/contact-10.tsx"
    }
  ],
  "categories": ["contact"],
  "type": "registry:block"
}
