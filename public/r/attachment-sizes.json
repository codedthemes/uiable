  "files": [
    {
      "path": "src/components/uiable/attachment/attachment-sizes.tsx",
      "content": "\"use client\"\n\n// shadcn\nimport {\n  Attachment,\n  AttachmentAction,\n  AttachmentActions,\n  AttachmentContent,\n  AttachmentDescription,\n  AttachmentMedia,\n  AttachmentTitle,\n} from \"@/components/ui/attachment\"\nimport { Badge } from \"@/components/ui/badge\"\n\n// assets\nimport { FileText, X } from \"lucide-react\"\n\n//  ------------------------------ | ATTACHMENT - SIZES | ------------------------------  //\n\nexport default function AttachmentSizes() {\n  return (\n    <div className=\"mx-auto w-full max-w-sm py-12\">\n      <div className=\"flex w-full flex-col gap-6\">\n        {/* Default / Large Size */}\n        <div className=\"flex flex-col gap-2\">\n          <div className=\"flex items-center justify-between\">\n            <h4 className=\"text-xs font-medium tracking-wider text-muted-foreground uppercase\">\n              Default\n            </h4>\n            <Badge className=\"rounded-sm border-transparent bg-green-500/10 px-1.5 py-0.5 font-mono text-[10px] text-green-500\">\n              size=\"default\"\n            </Badge>\n          </div>\n          <Attachment className=\"w-full\">\n            <AttachmentMedia>\n              <FileText className=\"size-4\" />\n            </AttachmentMedia>\n            <AttachmentContent>\n              <AttachmentTitle>annual-report-2026.pdf</AttachmentTitle>\n              <AttachmentDescription>PDF • 4.2 MB</AttachmentDescription>\n            </AttachmentContent>\n            <AttachmentActions>\n              <AttachmentAction aria-label=\"Remove annual-report-2026.pdf\">\n                <X className=\"size-4\" />\n              </AttachmentAction>\n            </AttachmentActions>\n          </Attachment>\n        </div>\n\n        {/* Small Size */}\n        <div className=\"flex flex-col gap-2\">\n          <div className=\"flex items-center justify-between\">\n            <h4 className=\"text-xs font-medium tracking-wider text-muted-foreground uppercase\">\n              Small\n            </h4>\n            <Badge className=\"rounded-sm border-transparent bg-green-500/10 px-1.5 py-0.5 font-mono text-[10px] text-green-500\">\n              size=\"sm\"\n            </Badge>\n          </div>\n          <Attachment size=\"sm\" className=\"w-full\">\n            <AttachmentMedia>\n              <FileText className=\"size-4\" />\n            </AttachmentMedia>\n            <AttachmentContent>\n              <AttachmentTitle>hero-background.jpg</AttachmentTitle>\n              <AttachmentDescription>JPG • 1.8 MB</AttachmentDescription>\n            </AttachmentContent>\n            <AttachmentActions>\n              <AttachmentAction aria-label=\"Remove hero-background.jpg\">\n                <X className=\"size-4\" />\n              </AttachmentAction>\n            </AttachmentActions>\n          </Attachment>\n        </div>\n\n        {/* Extra Small Size */}\n        <div className=\"flex flex-col gap-2\">\n          <div className=\"flex items-center justify-between\">\n            <h4 className=\"text-xs font-medium tracking-wider text-muted-foreground uppercase\">\n              Extra Small\n            </h4>\n            <Badge className=\"rounded-sm border-transparent bg-green-500/10 px-1.5 py-0.5 font-mono text-[10px] text-green-500\">\n              size=\"xs\"\n            </Badge>\n          </div>\n          <Attachment size=\"xs\" className=\"w-full\">\n            <AttachmentMedia>\n              <FileText className=\"size-4\" />\n            </AttachmentMedia>\n            <AttachmentContent>\n              <AttachmentTitle>signature-spec.png</AttachmentTitle>\n              <AttachmentDescription>PNG • 85 KB</AttachmentDescription>\n            </AttachmentContent>\n            <AttachmentActions>\n              <AttachmentAction aria-label=\"Remove signature-spec.png\">\n                <X className=\"size-3.5\" />\n              </AttachmentAction>\n            </AttachmentActions>\n          </Attachment>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/attachment/attachment-sizes.tsx"
    }
  ],
  "categories": ["attachment"],
  "type": "registry:ui"
}
