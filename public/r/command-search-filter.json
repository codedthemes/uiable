{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-search-filter",
  "title": "Command Search Filter",
  "description": "Command Search Filter variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/button", "@uiable/command", "@uiable/radio-group"],
  "files": [
    {
      "path": "src/components/uiable/command/command-search-filter.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n} from \"@/components/ui/command\"\nimport { RadioGroup, RadioGroupItem } from \"@/components/ui/radio-group\"\n\n// assets\nimport { Filter, Sparkles } from \"lucide-react\"\n\nconst categories = [\n  { value: \"all\", label: \"All\" },\n  { value: \"design\", label: \"Design\" },\n  { value: \"docs\", label: \"Documentation\" },\n  { value: \"product\", label: \"Product\" },\n]\n\nconst sortOptions = [\n  { value: \"recommended\", label: \"Recommended\" },\n  { value: \"newest\", label: \"Newest\" },\n  { value: \"popular\", label: \"Most Popular\" },\n  { value: \"updated\", label: \"Recently Updated\" },\n]\n\n//  ------------------------------ | COMMAND - SEARCH AND FILTER | ------------------------------  //\n\nexport function CommandSearchAndFilter() {\n  const [open, setOpen] = useState(false)\n  const [category, setCategory] = useState(\"all\")\n  const [sort, setSort] = useState(\"recommended\")\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <Button onClick={() => setOpen(true)}>Search and filter</Button>\n      <CommandDialog\n        open={open}\n        onOpenChange={setOpen}\n        title=\"Search and filter\"\n        description=\"Find the right item by focus, owner, and status\"\n      >\n        <Command>\n          <CommandInput placeholder=\"Search docs, tasks, and product views...\" />\n          <CommandList>\n            <CommandEmpty>No content matched your filters.</CommandEmpty>\n\n            {/* Category Filter Group */}\n            <CommandGroup\n              heading={\n                <div className=\"flex items-center gap-2\">\n                  <Filter className=\"size-4 text-muted-foreground\" />\n                  <span className=\"-mb-[2px] text-xs font-semibold tracking-wide uppercase\">\n                    Category\n                  </span>\n                </div>\n              }\n              className=\"py-2\"\n            >\n              <div className=\"px-2 py-2\">\n                <RadioGroup value={category} onValueChange={setCategory}>\n                  {categories.map((cat) => (\n                    <CommandItem key={cat.value}>\n                      <RadioGroupItem\n                        value={cat.value}\n                        id={`cat-${cat.value}`}\n                      />\n                      <label\n                        htmlFor={`cat-${cat.value}`}\n                        className=\"flex-1 cursor-pointer text-sm text-foreground\"\n                      >\n                        {cat.label}\n                      </label>\n                    </CommandItem>\n                  ))}\n                </RadioGroup>\n              </div>\n            </CommandGroup>\n\n            <CommandSeparator />\n\n            {/* Sort Filter Group */}\n            <CommandGroup\n              heading={\n                <div className=\"flex items-center gap-2\">\n                  <Sparkles className=\"size-4 text-muted-foreground\" />\n                  <span className=\"-mb-[2px] text-xs font-semibold tracking-wide uppercase\">\n                    Sort by\n                  </span>\n                </div>\n              }\n              className=\"py-2\"\n            >\n              <div className=\"px-2 py-2\">\n                <RadioGroup value={sort} onValueChange={setSort}>\n                  {sortOptions.map((opt) => (\n                    <CommandItem key={opt.value}>\n                      <RadioGroupItem\n                        value={opt.value}\n                        id={`sort-${opt.value}`}\n                      />\n                      <label\n                        htmlFor={`sort-${opt.value}`}\n                        className=\"flex-1 cursor-pointer text-sm text-foreground\"\n                      >\n                        {opt.label}\n                      </label>\n                    </CommandItem>\n                  ))}\n                </RadioGroup>\n              </div>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </CommandDialog>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/command/command-search-filter.tsx"
    }
  ],
  "categories": ["command"],
  "type": "registry:ui"
}
