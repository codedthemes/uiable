{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "kbd-tooltip",
  "title": "Kbd Tooltip",
  "description": "Kbd Tooltip variant for component.",
  "registryDependencies": ["@uiable/button", "@uiable/kbd", "@uiable/tooltip"],
  "files": [
