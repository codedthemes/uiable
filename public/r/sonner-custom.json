{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sonner-custom",
  "title": "Sonner Custom",
  "description": "Sonner Custom variant for component.",
  "dependencies": ["lucide-react", "sonner"],
  "registryDependencies": ["@uiable/button"],
  "files": [
    {
      "path": "src/components/uiable/sonner/sonner-custom.tsx",
      "content": "\"use client\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\n\n// third-party\nimport { toast } from \"sonner\"\n\n// assets\nimport { CheckCircle2 } from \"lucide-react\"\n\n//  ------------------------------ | SONNER - CUSTOM | ------------------------------  //\n\nexport function SonnerCustom() {\n  return (\n    <Button\n      onClick={() =>\n        toast.custom((t) => (\n          <div className=\"flex w-full items-center gap-3 rounded-lg border border-border bg-background p-4 shadow-lg\">\n            <CheckCircle2 className=\"size-5 text-green-500\" />\n            <div className=\"flex flex-col gap-1\">\n              <span className=\"text-sm font-medium\">Custom Layout</span>\n              <span className=\"text-xs text-muted-foreground\">\n                This is a fully custom toast component.\n              </span>\n            </div>\n            <Button\n              size=\"sm\"\n              variant=\"outline\"\n              className=\"ml-auto h-7 text-xs\"\n              onClick={() => toast.dismiss(t)}\n            >\n              Dismiss\n            </Button>\n          </div>\n        ))\n      }\n      className=\"w-fit\"\n    >\n      Show Custom Toast\n    </Button>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/sonner/sonner-custom.tsx"
    }
  ],
  "categories": ["sonner"],
  "type": "registry:ui"
}
