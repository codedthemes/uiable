{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dropdown-menu-notifications",
  "title": "Dropdown Menu Notifications",
  "description": "Dropdown Menu Notifications variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/button", "@uiable/dropdown-menu"],
  "files": [
    {
      "path": "src/components/uiable/dropdown-menu/dropdown-menu-notifications.tsx",
      "content": "// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\n\n// assets\nimport {\n  BellIcon,\n  HeartIcon,\n  MessageCircleIcon,\n  UserPlusIcon,\n} from \"lucide-react\"\n\nconst notifications = [\n  {\n    id: 1,\n    icon: <HeartIcon className=\"text-rose-500\" />,\n    title: \"Jane liked your post\",\n    time: \"2 hours ago\",\n    unread: true,\n  },\n  {\n    id: 2,\n    icon: <MessageCircleIcon className=\"text-blue-500\" />,\n    title: \"Alex commented on your photo\",\n    time: \"4 hours ago\",\n    unread: true,\n  },\n  {\n    id: 3,\n    icon: <UserPlusIcon className=\"text-green-500\" />,\n    title: \"Mike started following you\",\n    time: \"Yesterday\",\n    unread: false,\n  },\n]\n\n//  ------------------------------ | DROPDOWN MENU - NOTIFICATIONS | ------------------------------  //\n\nexport function DropdownMenuNotifications() {\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger\n        render={\n          <Button\n            variant=\"outline\"\n            size=\"icon\"\n            className=\"relative dark:border-border\"\n          />\n        }\n      >\n        <BellIcon />\n        <span className=\"absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-destructive\" />\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\" className=\"w-[320px]\">\n        <div className=\"flex items-center justify-between px-2 py-2\">\n          <DropdownMenuGroup>\n            <DropdownMenuLabel className=\"text-md p-0\">\n              Notifications\n            </DropdownMenuLabel>\n          </DropdownMenuGroup>\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            className=\"h-auto px-2 py-1 text-xs\"\n          >\n            Mark all read\n          </Button>\n        </div>\n        <DropdownMenuSeparator />\n        <DropdownMenuGroup>\n          {notifications.map((notification) => (\n            <DropdownMenuItem\n              key={notification.id}\n              className=\"items-start gap-4 p-3\"\n            >\n              <div className=\"mt-0.5 shrink-0 [&_svg]:size-4\">\n                {notification.icon}\n              </div>\n              <div className=\"flex flex-col gap-1\">\n                <h6 className=\"text-sm leading-none font-medium\">\n                  {notification.title}\n                </h6>\n                <p className=\"text-xs text-muted-foreground\">\n                  {notification.time}\n                </p>\n              </div>\n              {notification.unread && (\n                <span className=\"mt-1 ml-auto flex h-2 w-2 rounded-full bg-primary\" />\n              )}\n            </DropdownMenuItem>\n          ))}\n        </DropdownMenuGroup>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem className=\"justify-center text-center text-sm font-medium text-muted-foreground\">\n          View all notifications\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/dropdown-menu/dropdown-menu-notifications.tsx"
    }
  ],
  "categories": ["dropdown-menu"],
  "type": "registry:ui"
}
