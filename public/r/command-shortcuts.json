  "name": "command-shortcuts",
  "title": "Command Shortcuts",
  "description": "Command Shortcuts variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/button", "@uiable/command"],
  "files": [
    {
      "path": "src/components/uiable/command/command-shortcuts.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandShortcut,\n} from \"@/components/ui/command\"\n\n// assets\nimport { CreditCardIcon, SettingsIcon, UserIcon } from \"lucide-react\"\n\n//  ------------------------------ | COMMAND - SHORTCUTS | ------------------------------  //\n\nexport function CommandWithShortcuts() {\n  const [open, setOpen] = useState(false)\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <Button onClick={() => setOpen(true)} className=\"w-fit\">\n        Open Menu\n      </Button>\n      <CommandDialog open={open} onOpenChange={setOpen}>\n        <Command>\n          <CommandInput placeholder=\"Type a command or search...\" />\n          <CommandList>\n            <CommandEmpty>No results found.</CommandEmpty>\n            <CommandGroup heading=\"Settings\">\n              <CommandItem>\n                <UserIcon />\n                <span>Profile</span>\n                <CommandShortcut>⌘P</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <CreditCardIcon />\n                <span>Billing</span>\n                <CommandShortcut>⌘B</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <SettingsIcon />\n                <span>Settings</span>\n                <CommandShortcut>⌘S</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </CommandDialog>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/command/command-shortcuts.tsx"
    }
  ],
  "categories": ["command"],
  "type": "registry:ui"
}
