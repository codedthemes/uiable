      "path": "src/components/uiable/widget/profile-card.tsx",
      "content": "\"use client\"\n\n// shadcn\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Button, buttonVariants } from \"@/components/ui/button\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\n\n// project-imports\n// project\nimport { cn } from \"@/lib/utils\"\n\n// assets\nimport { AtSign, MoreVertical, Plus } from \"lucide-react\"\n\n//  ------------------------------ | BLOCK - PROFILE CARD | ------------------------------  //\n\nexport default function ProfileCard() {\n  return (\n    <Card>\n      <CardContent className=\"p-6\">\n        <div className=\"mb-6 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary\">\n              <AtSign className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <h6 className=\"text-sm leading-tight font-semibold\">UIAble</h6>\n              <p className=\"text-xs text-muted-foreground\">@uiabledevelop</p>\n            </div>\n          </div>\n          <DropdownMenu>\n            <DropdownMenuTrigger\n              className={cn(\n                buttonVariants({ variant: \"ghost\", size: \"icon\" }),\n                \"h-8 w-8 shrink-0 rounded-xl\"\n              )}\n            >\n              <MoreVertical className=\"h-4 w-4\" />\n            </DropdownMenuTrigger>\n            <DropdownMenuContent align=\"end\">\n              <DropdownMenuItem>Today</DropdownMenuItem>\n              <DropdownMenuItem>Weekly</DropdownMenuItem>\n              <DropdownMenuItem>Monthly</DropdownMenuItem>\n            </DropdownMenuContent>\n          </DropdownMenu>\n        </div>\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex -space-x-2 overflow-hidden\">\n            <Avatar className=\"h-8 w-8 border-2 border-background\">\n              <AvatarImage src=\"https://cdn.uiable.com/user/avatar-1.jpg\" />\n            </Avatar>\n            <Avatar className=\"h-8 w-8 border-2 border-background\">\n              <AvatarImage src=\"https://cdn.uiable.com/user/avatar-3.jpg\" />\n            </Avatar>\n            <Avatar className=\"h-8 w-8 border-2 border-background\">\n              <AvatarImage src=\"https://cdn.uiable.com/user/avatar-4.jpg\" />\n            </Avatar>\n            <Avatar className=\"h-8 w-8 border-2 border-background\">\n              <AvatarImage src=\"https://cdn.uiable.com/user/avatar-5.jpg\" />\n            </Avatar>\n            <Avatar className=\"h-8 w-8 border-2 border-background\">\n              <AvatarFallback className=\"bg-primary/10 text-[10px] font-bold text-primary\">\n                +2\n              </AvatarFallback>\n            </Avatar>\n          </div>\n          <Button\n            variant=\"default\"\n            size=\"icon\"\n            className=\"h-10 w-10 rounded-full\"\n          >\n            <Plus className=\"h-5 w-5\" />\n          </Button>\n        </div>\n      </CardContent>\n    </Card>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/widget/profile-card.tsx"
    }
  ],
  "categories": ["widget"],
  "type": "registry:ui"
}
