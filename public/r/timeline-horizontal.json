      "path": "src/components/uiable/timeline/timeline-horizontal.tsx",
      "content": "// shadcn\nimport { Badge } from \"@/components/ui/badge\"\nimport {\n  Timeline,\n  TimelineConnector,\n  TimelineContent,\n  TimelineDescription,\n  TimelineHeader,\n  TimelineIndicator,\n  TimelineItem,\n  TimelineSeparator,\n  TimelineTime,\n  TimelineTitle,\n} from \"@/components/ui/timeline\"\n\n// assets\nimport { Check, Clock, Flag, Milestone, Sparkles } from \"lucide-react\"\n\n//  ------------------------------ | TIMELINE - HORIZONTAL | ------------------------------  //\n\nexport function TimelineHorizontal() {\n  return (\n    <div className=\"w-full max-w-2xl rounded-lg border bg-card/60 p-5\">\n      <div className=\"mb-6 flex flex-wrap items-center justify-between gap-2 border-b pb-4\">\n        <div>\n          <h3 className=\"text-sm font-semibold\">Product Roadmap 2026</h3>\n          <p className=\"text-xs text-muted-foreground\">\n            Strategic release milestones\n          </p>\n        </div>\n        <Badge variant=\"outline\" className=\"gap-1 text-xs font-normal\">\n          <Milestone className=\"size-3 text-primary\" />\n          Q1 - Q4 Roadmap\n        </Badge>\n      </div>\n\n      <div className=\"w-full overflow-x-auto pt-2 pb-2\">\n        <Timeline\n          orientation=\"horizontal\"\n          size=\"default\"\n          className=\"min-w-[520px]\"\n        >\n          {/* Q1 */}\n          <TimelineItem status=\"completed\">\n            <TimelineSeparator>\n              <TimelineIndicator variant=\"completed\">\n                <Check className=\"size-3.5\" />\n              </TimelineIndicator>\n              <TimelineConnector />\n            </TimelineSeparator>\n            <TimelineContent>\n              <TimelineHeader>\n                <TimelineTitle className=\"text-xs font-semibold\">\n                  Q1: Foundation\n                </TimelineTitle>\n                <TimelineTime>Done</TimelineTime>\n              </TimelineHeader>\n              <TimelineDescription className=\"text-xs\">\n                Tailwind CSS v4 migration & 60+ shadcn base primitives.\n              </TimelineDescription>\n            </TimelineContent>\n          </TimelineItem>\n\n          {/* Q2 */}\n          <TimelineItem status=\"in-progress\">\n            <TimelineSeparator>\n              <TimelineIndicator variant=\"in-progress\">\n                <Sparkles className=\"size-3.5\" />\n              </TimelineIndicator>\n              <TimelineConnector />\n            </TimelineSeparator>\n            <TimelineContent>\n              <TimelineHeader>\n                <TimelineTitle className=\"text-xs font-semibold text-primary\">\n                  Q2: AI Primitives\n                </TimelineTitle>\n                <TimelineTime>In Progress</TimelineTime>\n              </TimelineHeader>\n              <TimelineDescription className=\"text-xs\">\n                Chain-of-Thought, timeline, prompt inputs, and stream widgets.\n              </TimelineDescription>\n            </TimelineContent>\n          </TimelineItem>\n\n          {/* Q3 */}\n          <TimelineItem status=\"pending\">\n            <TimelineSeparator>\n              <TimelineIndicator variant=\"outline\">\n                <Clock className=\"size-3.5\" />\n              </TimelineIndicator>\n              <TimelineConnector />\n            </TimelineSeparator>\n            <TimelineContent>\n              <TimelineHeader>\n                <TimelineTitle className=\"text-xs font-semibold text-muted-foreground\">\n                  Q3: Visual Canvas\n                </TimelineTitle>\n                <TimelineTime>Planned</TimelineTime>\n              </TimelineHeader>\n              <TimelineDescription className=\"text-xs\">\n                Workflow canvas, edge connectors, and node layout editor.\n              </TimelineDescription>\n            </TimelineContent>\n          </TimelineItem>\n\n          {/* Q4 */}\n          <TimelineItem status=\"pending\">\n            <TimelineSeparator>\n              <TimelineIndicator variant=\"outline\">\n                <Flag className=\"size-3.5\" />\n              </TimelineIndicator>\n            </TimelineSeparator>\n            <TimelineContent>\n              <TimelineHeader>\n                <TimelineTitle className=\"text-xs font-semibold text-muted-foreground\">\n                  Q4: 2.0 Global\n                </TimelineTitle>\n                <TimelineTime>Planned</TimelineTime>\n              </TimelineHeader>\n              <TimelineDescription className=\"text-xs\">\n                Self-hosted private registry and enterprise team sharing.\n              </TimelineDescription>\n            </TimelineContent>\n          </TimelineItem>\n        </Timeline>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/timeline/timeline-horizontal.tsx"
    }
  ],
  "categories": ["timeline"],
  "type": "registry:ui"
}
