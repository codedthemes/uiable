      "path": "src/components/uiable/sonner/sonner-position.tsx",
      "content": "\"use client\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\n\n// third-party\n// third party\nimport { toast } from \"sonner\"\n\n//  ------------------------------ | SONNER - POSITION | ------------------------------  //\n\nexport function SonnerPosition() {\n  return (\n    <div className=\"flex flex-col gap-2\">\n      <div className=\"flex flex-wrap justify-center gap-2\">\n        <Button\n          onClick={() =>\n            toast(\"Event has been created\", { position: \"top-left\" })\n          }\n        >\n          Top Left\n        </Button>\n        <Button\n          onClick={() =>\n            toast(\"Event has been created\", { position: \"top-center\" })\n          }\n        >\n          Top Center\n        </Button>\n        <Button\n          onClick={() =>\n            toast(\"Event has been created\", { position: \"top-right\" })\n          }\n        >\n          Top Right\n        </Button>\n      </div>\n      <div className=\"flex flex-wrap justify-center gap-2\">\n        <Button\n          onClick={() =>\n            toast(\"Event has been created\", { position: \"bottom-left\" })\n          }\n        >\n          Bottom Left\n        </Button>\n        <Button\n          onClick={() =>\n            toast(\"Event has been created\", { position: \"bottom-center\" })\n          }\n        >\n          Bottom Center\n        </Button>\n        <Button\n          onClick={() =>\n            toast(\"Event has been created\", { position: \"bottom-right\" })\n          }\n        >\n          Bottom Right\n        </Button>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/sonner/sonner-position.tsx"
    }
