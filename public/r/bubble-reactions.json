{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "bubble-reactions",
  "title": "Bubble Reactions",
  "description": "Bubble Reactions variant for component.",
  "dependencies": ["sonner"],
  "registryDependencies": ["@uiable/bubble", "@uiable/button"],
  "files": [
    {
      "path": "src/components/uiable/bubble/bubble-reactions.tsx",
      "content": "\"use client\"\n\n// shadcn\nimport { Bubble, BubbleContent, BubbleReactions } from \"@/components/ui/bubble\"\nimport { Button } from \"@/components/ui/button\"\n\n// third-party\nimport { toast } from \"sonner\"\n\n//  ------------------------------ | BUBBLE - REACTIONS | ------------------------------  //\n\nexport function BubbleReaction() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-12\">\n      <Bubble variant=\"muted\" align=\"end\">\n        <BubbleContent>\n          I don&apos;t need tests, I know my code works.\n        </BubbleContent>\n        <BubbleReactions\n          align=\"start\"\n          role=\"img\"\n          aria-label=\"Reactions: thumbs up, surprised\"\n        >\n          <span>👍</span>\n          <span>😮</span>\n        </BubbleReactions>\n      </Bubble>\n      <Bubble variant=\"muted\">\n        <BubbleContent>\n          Bold. Fine I&apos;ll add some tests. I&apos;ll let you know when\n          they&apos;re done.\n        </BubbleContent>\n        <BubbleReactions\n          role=\"img\"\n          aria-label=\"Reactions: eyes, rocket, and 2 more\"\n        >\n          <span>👀</span>\n          <span>🚀</span>\n          <span>+2</span>\n        </BubbleReactions>\n      </Bubble>\n      <Bubble variant=\"default\" align=\"end\">\n        <BubbleContent className=\"dark:text-white\">\n          Tests passed on the first try. All 142 of them. Looking good!\n        </BubbleContent>\n        <BubbleReactions\n          side=\"top\"\n          align=\"start\"\n          role=\"img\"\n          aria-label=\"Reactions: party popper, clapping hands\"\n        >\n          <span>🎉</span>\n          <span>👏</span>\n        </BubbleReactions>\n      </Bubble>\n      <Bubble variant=\"destructive\">\n        <BubbleContent>Are you sure I can run this command?</BubbleContent>\n        <BubbleReactions>\n          <Button\n            variant=\"ghost\"\n            size=\"xs\"\n            onClick={() => toast.success(\"You clicked yes, running command...\")}\n          >\n            Yes, run it\n          </Button>\n        </BubbleReactions>\n      </Bubble>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/bubble/bubble-reactions.tsx"
    }
  ],
  "categories": ["bubble"],
  "type": "registry:ui"
}
