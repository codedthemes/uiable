{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-navbar-6",
  "title": "Navbar 6",
  "description": "Navbar 6 variant for block.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/button", "@uiable/logo", "@uiable/mobile-nav", "@uiable/sheet"],
  "files": [
    {
      "path": "src/components/uiable/blocks/navbar/navbar-6/navbar-6.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\n// shadcn\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetTitle,\n  SheetTrigger,\n} from \"@/components/ui/sheet\"\n\n// project-imports\nimport Logo from \"@/components/uiable/layout/shared/logo\"\nimport MobileNav from \"@/components/uiable/layout/shared/mobile-nav\"\n\n// assets\nimport { ArrowRight, Menu } from \"lucide-react\"\n\n//  ------------------------------ | NAVBAR - CENTERED | ------------------------------  //\n\nexport default function Navbar6() {\n  const [isMenuOpen, setIsMenuOpen] = useState(false)\n\n  return (\n    <header className=\"w-full bg-background/95 px-5 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n      <div className=\"container mx-auto flex h-16 items-center justify-between\">\n        {/* Left: Mobile Menu + Logo */}\n        <div className=\"flex items-center gap-2\">\n          {/* Mobile Menu Toggle */}\n          <Sheet open={isMenuOpen} onOpenChange={setIsMenuOpen}>\n            <SheetTrigger className=\"h-9 gap-2 px-2 text-primary hover:bg-primary/5 lg:hidden\">\n              <Menu className=\"h-5 w-5\" />\n              <span className=\"sr-only\">Toggle Menu</span>\n            </SheetTrigger>\n            <SheetContent\n              side=\"left\"\n              className=\"w-72 bg-card p-0 *:data-[slot=sheet-close]:top-6\"\n            >\n              <SheetTitle className=\"px-6 pt-6\">\n                <Logo />\n              </SheetTitle>\n              <div className=\"flex flex-col gap-4 p-6\">\n                <MobileNav onSelect={() => setIsMenuOpen(false)} />\n              </div>\n            </SheetContent>\n          </Sheet>\n          <Logo />\n        </div>\n\n        {/* Center: Navigation Menu */}\n        <div className=\"hidden lg:flex\">\n          <nav className=\"flex items-center gap-6\">\n            <a\n              href=\"#\"\n              className=\"text-base font-medium text-muted-foreground transition-colors hover:text-primary\"\n            >\n              Dashboard\n            </a>\n            <a\n              href=\"#\"\n              className=\"text-base font-medium text-muted-foreground transition-colors hover:text-primary\"\n            >\n              Components\n            </a>\n            <a\n              href=\"#\"\n              className=\"text-base font-medium text-muted-foreground transition-colors hover:text-primary\"\n            >\n              Blocks\n            </a>\n            <a\n              href=\"#\"\n              className=\"text-base font-medium text-muted-foreground transition-colors hover:text-primary\"\n            >\n              Documentation\n            </a>\n          </nav>\n        </div>\n\n        {/* Right: Actions */}\n        <div className=\"flex items-center gap-2\">\n          <Button variant=\"ghost\" className=\"hidden sm:inline-flex\">\n            Log in\n          </Button>\n          <Button size=\"icon\" className=\"h-9 w-9 sm:hidden\">\n            <ArrowRight className=\"size-4\" />\n            <span className=\"sr-only\">Get Started</span>\n          </Button>\n          <Button className=\"hidden sm:inline-flex\">Get Started</Button>\n        </div>\n      </div>\n    </header>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/blocks/navbar/navbar-6/navbar-6.tsx"
    }
  ],
  "categories": ["navbar"],
  "type": "registry:block"
}
