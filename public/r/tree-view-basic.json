{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tree-view-basic",
  "title": "Tree View Basic",
  "description": "Tree View Basic variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/card", "@uiable/tree-view"],
  "files": [
    {
      "path": "src/components/uiable/tree-view/tree-view-basic.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\n// shadcn\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\nimport {\n  TreeView,\n  TreeItem,\n  TreeItemRow,\n  TreeItemToggle,\n  TreeItemIcon,\n  TreeItemLabel,\n  TreeItemContent,\n} from \"@/components/ui/tree-view\"\n\n// assets\nimport { FileCode, FileSpreadsheet, FileText, Folder } from \"lucide-react\"\n\n//  ------------------------------ | TREE VIEW - BASIC | ------------------------------  //\n\nexport default function TreeViewBasic() {\n  const [selected, setSelected] = useState<string | string[]>(\"app-page\")\n\n  return (\n    <Card className=\"w-full max-w-md\">\n      <CardHeader className=\"py-3\">\n        <CardTitle className=\"text-base\">Project Structure</CardTitle>\n        <CardDescription>\n          Expand folders and click items to select files.\n        </CardDescription>\n      </CardHeader>\n      <CardContent>\n        <TreeView\n          value={selected}\n          onValueChange={setSelected}\n          defaultExpandedValues={[\"src\", \"app\", \"components\"]}\n          className=\"rounded-lg bg-background/50 p-2\"\n        >\n          {/* src folder */}\n          <TreeItem value=\"src\" hasChildren level={0}>\n            <TreeItemRow>\n              <TreeItemToggle />\n              <TreeItemIcon>\n                <Folder className=\"fill-yellow-500/20 text-yellow-500\" />\n              </TreeItemIcon>\n              <TreeItemLabel>src</TreeItemLabel>\n            </TreeItemRow>\n\n            <TreeItemContent>\n              {/* app folder */}\n              <TreeItem value=\"app\" hasChildren level={1}>\n                <TreeItemRow>\n                  <TreeItemToggle />\n                  <TreeItemIcon>\n                    <Folder className=\"fill-yellow-500/20 text-yellow-500\" />\n                  </TreeItemIcon>\n                  <TreeItemLabel>app</TreeItemLabel>\n                </TreeItemRow>\n\n                <TreeItemContent>\n                  <TreeItem value=\"app-layout\" level={2}>\n                    <TreeItemRow>\n                      <TreeItemToggle />\n                      <TreeItemIcon>\n                        <FileCode className=\"text-cyan-500\" />\n                      </TreeItemIcon>\n                      <TreeItemLabel>layout.tsx</TreeItemLabel>\n                    </TreeItemRow>\n                  </TreeItem>\n\n                  <TreeItem value=\"app-page\" level={2}>\n                    <TreeItemRow>\n                      <TreeItemToggle />\n                      <TreeItemIcon>\n                        <FileCode className=\"text-cyan-500\" />\n                      </TreeItemIcon>\n                      <TreeItemLabel>page.tsx</TreeItemLabel>\n                    </TreeItemRow>\n                  </TreeItem>\n\n                  <TreeItem value=\"app-globals\" level={2}>\n                    <TreeItemRow>\n                      <TreeItemToggle />\n                      <TreeItemIcon>\n                        <FileSpreadsheet className=\"text-red-500\" />\n                      </TreeItemIcon>\n                      <TreeItemLabel>globals.css</TreeItemLabel>\n                    </TreeItemRow>\n                  </TreeItem>\n                </TreeItemContent>\n              </TreeItem>\n\n              {/* components folder */}\n              <TreeItem value=\"components\" hasChildren level={1}>\n                <TreeItemRow>\n                  <TreeItemToggle />\n                  <TreeItemIcon>\n                    <Folder className=\"fill-yellow-500/20 text-yellow-500\" />\n                  </TreeItemIcon>\n                  <TreeItemLabel>components</TreeItemLabel>\n                </TreeItemRow>\n\n                <TreeItemContent>\n                  <TreeItem value=\"comp-button\" level={2}>\n                    <TreeItemRow>\n                      <TreeItemToggle />\n                      <TreeItemIcon>\n                        <FileCode className=\"text-cyan-500\" />\n                      </TreeItemIcon>\n                      <TreeItemLabel>button.tsx</TreeItemLabel>\n                    </TreeItemRow>\n                  </TreeItem>\n\n                  <TreeItem value=\"comp-dialog\" level={2}>\n                    <TreeItemRow>\n                      <TreeItemToggle />\n                      <TreeItemIcon>\n                        <FileCode className=\"text-cyan-500\" />\n                      </TreeItemIcon>\n                      <TreeItemLabel>dialog.tsx</TreeItemLabel>\n                    </TreeItemRow>\n                  </TreeItem>\n                </TreeItemContent>\n              </TreeItem>\n\n              {/* lib folder */}\n              <TreeItem value=\"lib\" hasChildren level={1}>\n                <TreeItemRow>\n                  <TreeItemToggle />\n                  <TreeItemIcon>\n                    <Folder className=\"fill-yellow-500/20 text-yellow-500\" />\n                  </TreeItemIcon>\n                  <TreeItemLabel>lib</TreeItemLabel>\n                </TreeItemRow>\n\n                <TreeItemContent>\n                  <TreeItem value=\"lib-utils\" level={2}>\n                    <TreeItemRow>\n                      <TreeItemToggle />\n                      <TreeItemIcon>\n                        <FileCode className=\"text-cyan-500\" />\n                      </TreeItemIcon>\n                      <TreeItemLabel>utils.ts</TreeItemLabel>\n                    </TreeItemRow>\n                  </TreeItem>\n                </TreeItemContent>\n              </TreeItem>\n            </TreeItemContent>\n          </TreeItem>\n\n          {/* Root config files */}\n          <TreeItem value=\"package-json\" level={0}>\n            <TreeItemRow>\n              <TreeItemToggle />\n              <TreeItemIcon>\n                <FileText className=\"text-green-500\" />\n              </TreeItemIcon>\n              <TreeItemLabel>package.json</TreeItemLabel>\n            </TreeItemRow>\n          </TreeItem>\n\n          <TreeItem value=\"readme\" level={0}>\n            <TreeItemRow>\n              <TreeItemToggle />\n              <TreeItemIcon>\n                <FileText className=\"text-muted-foreground\" />\n              </TreeItemIcon>\n              <TreeItemLabel>README.md</TreeItemLabel>\n            </TreeItemRow>\n          </TreeItem>\n        </TreeView>\n\n        <div className=\"mt-3 flex items-center justify-between text-xs text-muted-foreground\">\n          <span>Active Selection:</span>\n          <code className=\"rounded bg-muted px-1.5 py-0.5 font-mono font-medium text-foreground\">\n            {selected || \"none\"}\n          </code>\n        </div>\n      </CardContent>\n    </Card>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/tree-view/tree-view-basic.tsx"
    }
  ],
  "categories": ["tree-view"],
  "type": "registry:ui"
}
