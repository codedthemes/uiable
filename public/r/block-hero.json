      "content": "// types\nimport type { SVGAttributes } from \"react\"\n\n//  ------------------------------ | BRAND LOGO — ABLE PRO | ------------------------------  //\n\nexport default function AbleProLogo(props: SVGAttributes<SVGSVGElement>) {\n  return (\n    <svg\n      width=\"22\"\n      height=\"22\"\n      viewBox=\"0 0 22 22\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      {...props}\n    >\n      <path\n        d=\"M19.6434 13.1647C20.7644 13.1647 21.4499 14.412 20.8159 15.3297C20.5505 15.7142 20.2459 16.0797 19.9021 16.4207L16.5555 19.7401C13.5526 22.7185 8.68295 22.7185 5.68002 19.7401L2.2522 16.3402C-0.750732 13.3617 -0.750732 8.53173 2.2522 5.55326L5.59886 2.23385C8.60179 -0.744617 13.4714 -0.744617 16.4743 2.23385L19.9021 5.63376C20.2363 5.96523 20.5333 6.31942 20.792 6.69161C21.4165 7.58752 20.7481 8.81111 19.6501 8.81111C19.2681 8.81111 18.9044 8.6539 18.6446 8.37642L14.5026 3.96127C12.6216 2.09558 9.57284 2.09558 7.69088 3.96127L3.99571 7.62919C2.1147 9.49583 2.1147 12.5207 3.99571 14.3854L7.65269 18.0126C9.5337 19.8783 12.5825 19.8783 14.4644 18.0126L18.616 13.607C18.8824 13.3247 19.2548 13.1647 19.6434 13.1647Z\"\n        fill=\"#5B84FA\"\n      />\n      <path\n        d=\"M15.2789 12.8664L12.972 15.1544C11.9255 16.1924 10.2298 16.1924 9.18327 15.1544L6.87642 12.8664C5.82993 11.8284 5.82993 10.1464 6.87642 9.10848L9.18327 6.82041C10.2298 5.78244 11.9255 5.78244 12.972 6.82041L15.2789 9.10848C16.3254 10.1474 16.3254 11.8284 15.2789 12.8664Z\"\n        fill=\"#A9EEF5\"\n      />\n    </svg>\n  )\n}\n",
