      "content": "// types\nimport type { SVGAttributes } from \"react\"\n\n//  ------------------------------ | SHADCN ICON | ------------------------------  //\n\nexport default function Shadcn(props: SVGAttributes<SVGElement>) {\n  return (\n    <svg\n      width=\"24\"\n      height=\"24\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      {...props}\n    >\n      <path\n        d=\"M19.0101 11.55L11.5501 19.01C11.0901 19.47 11.0901 20.2 11.5501 20.66C11.7676 20.8774 12.0626 20.9995 12.3701 20.9995C12.6776 20.9995 12.9726 20.8774 13.1901 20.66L20.6501 13.2C21.1101 12.74 21.1101 12.01 20.6501 11.55C20.1901 11.09 19.4601 11.09 19.0001 11.55H19.0101ZM19.1701 3.34C18.7101 2.88 17.9801 2.88 17.5201 3.34L3.34012 17.52C2.88012 17.98 2.88012 18.71 3.34012 19.17C3.55764 19.3874 3.85259 19.5095 4.16012 19.5095C4.46765 19.5095 4.76259 19.3874 4.98012 19.17L19.1601 4.98999C19.6201 4.52999 19.6201 3.8 19.1601 3.34H19.1701Z\"\n        fill=\"currentColor\"\n      />\n    </svg>\n  )\n}\n",
