{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "radio-fields",
  "title": "Radio Fields",
  "description": "Radio Fields variant for component.",
  "dependencies": ["@base-ui/react", "framer-motion"],
