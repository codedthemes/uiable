      "content": "// shadcn\nimport {\n  Bubble,\n  BubbleContent,\n  BubbleGroup,\n  BubbleReactions,\n} from \"@/components/ui/bubble\"\n\n//  ------------------------------ | BUBBLE - GROUP | ------------------------------  //\n\nexport default function BubbleGroups() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-8\">\n      <Bubble variant=\"muted\">\n        <BubbleContent>Can you tell me what&apos;s the issue?</BubbleContent>\n      </Bubble>\n      <BubbleGroup>\n        <Bubble align=\"end\">\n          <BubbleContent className=\"dark:text-white\">\n            You tell me!\n          </BubbleContent>\n        </Bubble>\n        <Bubble align=\"end\">\n          <BubbleContent className=\"dark:text-white\">\n            It worked yesterday. You broke it!\n          </BubbleContent>\n        </Bubble>\n        <Bubble align=\"end\">\n          <BubbleContent className=\"dark:text-white\">\n            Find the bug and fix it.\n          </BubbleContent>\n          <BubbleReactions aria-label=\"Reactions: eyes\" align=\"start\">\n            <span>👀</span>\n          </BubbleReactions>\n        </Bubble>\n      </BubbleGroup>\n      <Bubble variant=\"muted\">\n        <BubbleContent>\n          Want me to diff yesterday&apos;s you against today&apos;s you?\n          It&apos;s a bit embarrassing.\n        </BubbleContent>\n      </Bubble>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/bubble/bubble-group.tsx"
    }
  ],
