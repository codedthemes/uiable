{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "message-actions",
  "title": "Message Actions",
  "description": "Message Actions variant for component.",
  "dependencies": ["lucide-react"],
  "registryDependencies": ["@uiable/bubble", "@uiable/button", "@uiable/message"],
  "files": [
    {
      "path": "src/components/uiable/message/message-actions.tsx",
      "content": "// shadcn\nimport { Bubble, BubbleContent } from \"@/components/ui/bubble\"\nimport { Button } from \"@/components/ui/button\"\nimport { Message, MessageContent, MessageFooter } from \"@/components/ui/message\"\n\n// assets\nimport {\n  CopyIcon,\n  RefreshCcwIcon,\n  ThumbsDownIcon,\n  ThumbsUpIcon,\n} from \"lucide-react\"\n\n//  ------------------------------ | MESSAGE - ACTIONS | ------------------------------  //\n\nexport function MessageActions() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-8\">\n      <Message>\n        <MessageContent>\n          <Bubble variant=\"muted\">\n            <BubbleContent>\n              The install failure is coming from the workspace package.\n            </BubbleContent>\n          </Bubble>\n          <MessageFooter>\n            <Button variant=\"ghost\" size=\"icon\" aria-label=\"Copy\" title=\"Copy\">\n              <CopyIcon />\n            </Button>\n            <Button variant=\"ghost\" size=\"icon\" aria-label=\"Like\" title=\"Like\">\n              <ThumbsUpIcon />\n            </Button>\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              aria-label=\"Dislike\"\n              title=\"Dislike\"\n            >\n              <ThumbsDownIcon />\n            </Button>\n          </MessageFooter>\n        </MessageContent>\n      </Message>\n      <Message align=\"end\">\n        <MessageContent>\n          <Bubble>\n            <BubbleContent className=\"dark:text-white\">\n              Okay drop me a link. Taking a look...\n            </BubbleContent>\n          </Bubble>\n          <MessageFooter className=\"gap-2\">\n            <span className=\"font-normal text-destructive\">Failed to send</span>\n            <Button\n              variant=\"ghost\"\n              size=\"icon-xs\"\n              title=\"Retry\"\n              aria-label=\"Retry\"\n            >\n              <RefreshCcwIcon />\n            </Button>\n          </MessageFooter>\n        </MessageContent>\n      </Message>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "@components/uiable/message/message-actions.tsx"
    }
  ],
  "categories": ["message"],
  "type": "registry:ui"
}
